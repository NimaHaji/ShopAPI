{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Issuer": "http://localhost:5033",
    "Audience": "http://localhost:5033",
    "SecretKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY",
    "AccessTokenMinutes": 10
  },
  "Payment": {
    "SamanTerminalId": "SANDBOX_TERMINAL_ID",
    "SamanRedirectUrl": "http://localhost:5033/api/Payment/CallBack/0",
    "SamanVerifyUrl": "https://sandbox.banktest.ir/saman/sep.shaparak.ir/verifyTxnRandomSessionkey/ipg/VerifyTransaction",
    "MerchantIdZarinPal": "SANDBOX_MERCHANT_ID",
    "ZarinPalCallBackUrl": "http://localhost:5033/api/Payment/CallBack/1",
    "ZarinPalVerifyUrl": "https://sandbox.zarinpal.com/pg/v4/payment/verify.json",
    "ZarinPal_AutoVerify": false,
    "ZarinPalCurrency": "IRT"
  },
  "ConnectionStrings": {
    "local": "Server=localhost;Database=ShopApi;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Seed": {
    "Enabled": true,
    "force": true
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [TraceId: {TraceId}] [UserId: {UserId}] [Method: {Method}] [Path: {Path}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/shopapi-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "rollingOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [TraceId: {TraceId}] [UserId: {UserId}] [Method: {Method}] [Path: {Path}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
